<?xml version="1.0"?>
<package format="3">
  <name>ppbng_gnss</name>
  <version>0.1.0</version>
  <description>Hardware-independent, read-only UM982 ASCII protocol parsing for PPBNG.</description>
  <maintainer email="yl3663@cornell.edu">Yiyuan Lin</maintainer>
  <author email="yl3663@cornell.edu">Yiyuan Lin</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>ppbng_interfaces</depend>
  <depend>ppbng_storage</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
