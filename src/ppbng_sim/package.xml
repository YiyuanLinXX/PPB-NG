<?xml version="1.0"?>
<package format="3">
  <name>ppbng_sim</name>
  <version>0.1.0</version>
  <description>Pure in-memory integration scenarios for PPBNG acquisition.</description>
  <maintainer email="yl3663@cornell.edu">Yiyuan Lin</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ppbng_core</depend>
  <depend>ppbng_orchestrator</depend>
  <depend>ppbng_timing</depend>
  <depend>ppbng_hsi</depend>
  <depend>ppbng_rgb</depend>
  <depend>ppbng_thermal</depend>
  <depend>ppbng_storage</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

